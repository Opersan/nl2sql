        "bill of material"
      ]
    },
    {
      "entity_id": "HR_EMPLOYEES",
      "root_table": "XXBT_PDKS_PER_DETAILS_V",
      "child_tables": [],
      "join_paths": [],
      "dimensions": {
        "birim": "BIRIM_ADI",
        "departman": "BIRIM_ADI",
        "lokasyon": "LOCATION_ADI",
        "unvan": "UNVAN"
      },
      "measures": {},
      "status_semantics": {
