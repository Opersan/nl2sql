      },
      "keywords": [
        "calisan",
        "calisanlar",
        "çalışan",
        "çalışanlar",
        "personel",
        "eleman"
      ],
      "default_intent": "emp_generic_list",
      "intent_rules": [],
      "intent_defaults": {
        "emp_generic_list": {
          "stable": false,
          "select_columns": ["SICIL_NO", "AD", "SOYAD", "BIRIM_ADI"],
          "group_by": [],
          "aggregations": [],
          "filters": [],
          "computed_measures": []
        }
      }
    }
  ]
}
