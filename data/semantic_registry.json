      ]
    },
    {
      "entity_id": "BOM_ENGINEERING",
      "root_table": "BOM_STRUCTURES_B",
      "child_tables": [],
      "join_paths": [],
      "dimensions": {},
      "measures": {},
      "status_semantics": {},
      "time_semantics": {},
      "keywords": [
        "bom",
