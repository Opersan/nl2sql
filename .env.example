# NL2SQL Assistant – Environment Configuration
APP_NAME=nl2sql-assistant
ENVIRONMENT=development
DEFAULT_ROW_LIMIT=100
MAX_ROW_LIMIT=1000

# LLM provider: "mock" or "openai_compatible"
LLM_PROVIDER=mock

# OpenAI-compatible endpoint (vLLM, llama.cpp, OpenAI, etc.)
OPENAI_BASE_URL=http://localhost:8000/v1
OPENAI_API_KEY=
OPENAI_MODEL=default

# API response settings
ENABLE_SQL_IN_API_RESPONSE=true
MAX_ROWS_PREVIEW=20

# Oracle executor (leave blank to use mock executor)
ENABLE_ORACLE_EXECUTOR=false
ORACLE_DSN=(DESCRIPTION=(ADDRESS=(PROTOCOL=tcp)(HOST=bestdbuat.besttransformer.com)(PORT=1541))(CONNECT_DATA=(SERVICE_NAME=ebs_UAT)(INSTANCE_NAME=EBSUATC)))
ORACLE_USER=apps
ORACLE_PASSWORD=Tgb20yHn22
ORACLE_TIMEOUT=30